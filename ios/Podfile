# require Pod::Executable.execute_command('node', ['-p',
#   'require.resolve(
#     "react-native/scripts/react_native_pods.rb",
#     {paths: [process.argv[1]]},
#   )', __dir__]).strip

# Use it to require both react-native's and this package's scripts:

def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
  "require.resolve(
    '#{script}',
    {paths: [process.argv[1]]},
    )", __dir__]).strip
end

# The app runs the old architecture on both platforms (android/gradle.properties
# has newArchEnabled=false, and the committed Podfile.lock was generated without
# Fabric). RN 0.77 turns the new architecture ON for iOS unless this is "0", so a
# clean `pod install` (CI, a fresh clone) used to produce a different, broken
# build: react-native-svg 15.15's Fabric code does not compile against 0.77.
# An explicit RCT_NEW_ARCH_ENABLED in the environment still wins.
ENV['RCT_NEW_ARCH_ENABLED'] ||= '0'

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '15.1'
prepare_react_native_project!

# ⬇️ uncomment the permissions you need
setup_permissions([
  # 'AppTrackingTransparency',
  'Bluetooth',
  # 'Calendars',
  # 'CalendarsWriteOnly',
  # 'Camera',
  # 'Contacts',
  # 'FaceID',
   'LocationAccuracy',
   'LocationAlways',
   'LocationWhenInUse',
  # 'MediaLibrary',
  # 'Microphone',
  # 'Motion',
  # 'Notifications',
  # 'PhotoLibrary',
  # 'PhotoLibraryAddOnly',
  # 'Reminders',
  # 'Siri',
  # 'SpeechRecognition',
  # 'StoreKit',
])

linkage = ENV['USE_FRAMEWORKS']
# if linkage != nil
#   Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
#   use_frameworks! :linkage => linkage.to_sym
# end

target 'Biostasis' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
  use_react_native!(
    :path => config[:reactNativePath],
    
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'BiostasisTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 blocks script phases by default; disable sandbox so RN scripts can run
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end

    # `fmt` 11.0.2 (pinned by React Native's third-party podspecs) trips Xcode
    # 26's clang on its consteval `basic_format_string` constructor, so a clean
    # Release build fails in format-inl.h. A command-line -DFMT_USE_CONSTEVAL=0
    # does not help because the header redefines the macro unconditionally.
    # Patch the header so consteval is never enabled. Sentinel-guarded, so a
    # repeated `pod install` is a no-op.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      File.chmod(0o644, fmt_base)
      content = File.read(fmt_base)
      sentinel = '// FMT_USE_CONSTEVAL force-off for Xcode 26 clang'
      unless content.include?(sentinel)
        patched = content.sub(
          "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n",
          "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n#define FMT_USE_CONSTEVAL 0  #{sentinel}\n#if 0  // original conditional disabled\n"
        ).sub(
          "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval",
          "#endif  // end forced FMT_USE_CONSTEVAL=0 block\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
        )
        File.write(fmt_base, patched)
      end
    end
  end
end

