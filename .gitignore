# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
# fastlane/.env holds the App Store Connect key and MATCH_PASSWORD. The `.env*`
# rule below already matches it; spelled out so nobody narrows that rule and
# leaks it.
fastlane/.env
!fastlane/.env.example
# Release signing and store credentials. The keystore should live outside the
# repo entirely; these are the safety net.
*.p8
*.jks
android/service-account-key.json
!android/keystore.properties.example

