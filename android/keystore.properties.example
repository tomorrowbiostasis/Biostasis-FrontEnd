# Copy to android/keystore.properties (gitignored) and fill in.
#
# This app is LIVE on Google Play. Do NOT generate a new keystore: Play
# rejects a bundle signed with a key it does not recognise. Use the existing
# upload key, and verify it before you rely on it:
#
#   keytool -list -v -keystore <your.keystore> -alias <your-alias> | grep SHA-256
#
# The SHA-256 must match Play Console -> Test and release -> App integrity ->
# App signing -> Upload key certificate. If the key is genuinely lost, the only
# path is Play Console -> "Request upload key reset".
#
# Prefer an ABSOLUTE path pointing OUTSIDE the repo (e.g. ~/.keys/biostasis/)
# so the keystore can never be committed by accident. Relative paths resolve
# against android/app/ (unchanged from the original setup).
#
# CI equivalent (used when this file is absent):
#   ANDROID_KEY_STORE_FILE / ANDROID_KEY_STORE_PASSWORD
#   ANDROID_KEY_ALIAS      / ANDROID_KEY_ALIAS_PASSWORD

storeFile=/absolute/path/to/biostasis-upload.keystore
storePassword=
keyAlias=
keyPassword=
