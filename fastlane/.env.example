# Copy to fastlane/.env (gitignored) and fill in. Local runs only: CI gets the
# same names from GitHub Actions secrets (see .github/workflows/release.yml).
#
# fastlane loads fastlane/.env automatically. There is NO --env flag to pass.
#
# Nothing in here may ever be committed. This repository is PUBLIC.

# ── App Store Connect API key ───────────────────────────────────────────────
# App Store Connect -> Users and Access -> Integrations -> App Store Connect
# API. Role: App Manager (Admin only if `fastlane ios certificates` must create
# new certificates).
#
# The .p8 downloads exactly once. Store it in the team password manager, then
# paste its base64 below as a single line. The lanes pass
# is_key_content_base64: true, which avoids the multi-line-PEM-in-a-dotenv
# problem that silently produces "invalid key" errors:
#
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n' | pbcopy
#
APP_STORE_CONNECT_KEY_ID=""
APP_STORE_CONNECT_ISSUER_ID=""
APP_STORE_CONNECT_KEY_CONTENT=""

# ── match ───────────────────────────────────────────────────────────────────
# Encrypts the private certs repo (see fastlane/Matchfile). If this password is
# lost, the repo is unrecoverable and every certificate must be revoked and
# regenerated. Keep it in the team password manager.
MATCH_PASSWORD=""
#
# Local access uses your own SSH key; nothing more is needed.
# CI only:
#   MATCH_GIT_URL="https://github.com/tomorrowbiostasis/biostasis-signing.git"
#   MATCH_GIT_BASIC_AUTHORIZATION="<base64 of 'user:personal-access-token'>"

# ── Android signing ─────────────────────────────────────────────────────────
# Prefer android/keystore.properties instead: Gradle reads that for a plain
# `./gradlew bundleProductionRelease` too, not just for fastlane. These env
# vars are the CI equivalent and are only consulted when that file is absent.
# ANDROID_KEY_STORE_FILE=""
# ANDROID_KEY_STORE_PASSWORD=""
# ANDROID_KEY_ALIAS=""
# ANDROID_KEY_ALIAS_PASSWORD=""

# Path to the Google Play service-account JSON. Defaults to
# android/service-account-key.json when unset.
# SUPPLY_JSON_KEY=""

# ── Optional ────────────────────────────────────────────────────────────────
# Leave empty to disable release notifications. The lanes skip the Slack step
# rather than failing a release that already succeeded.
SLACK_WEBHOOK_URL=""
