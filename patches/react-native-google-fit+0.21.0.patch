+    "no-case-declarations": [0],
+    "no-console": [0],
+    "no-duplicate-imports": [1, { "includeExports": false }],
+    "no-eval": ["error", { "allowIndirect": true }],
+    "no-mixed-operators": [0],
+    "no-unused-vars": [1],
+    "no-useless-return": [1],
