+    "curly": [2, "all"],
+    "generator-star-spacing": ["error", { "before": true, "after": false }],
+    "indent": [2, 2, { "SwitchCase": 1 }],
+    "jsx-quotes": [1, "prefer-single"],
+    "max-len": [1, 120, 2],
